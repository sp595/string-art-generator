# Firebase Configuration
# 1. Go to https://console.firebase.google.com/
# 2. Create a project (or use existing)
# 3. Enable Google Authentication in Authentication > Sign-in method
# 4. Create a Firestore database in Firestore Database
# 5. Add your web app and copy the config values below
# 6. Copy this file to .env and fill in your values
# 7. Add the same vars to Vercel: Project Settings > Environment Variables

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Without these vars, the app works normally with localStorage-only saves (no login required)
